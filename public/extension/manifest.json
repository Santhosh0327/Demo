{
  "manifest_version": 3,
  "name": "CasinoScores Intelligence Bridge",
  "version": "1.0.0",
  "description": "Reads user-approved visible CasinoScores roulette results and bridges them to Demo Roulette Intelligence.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.casino.org/casinoscores/*",
    "https://*.casinoscores.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CasinoScores Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.casino.org/casinoscores/*",
        "https://*.casinoscores.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
